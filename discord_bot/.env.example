# Copy to discord_bot/.env and fill in. Never commit the real .env.
DISCORD_TOKEN=

# The Discord server (guild) the bot serves; other servers are ignored.
# Right-click the server icon -> Copy Server ID (needs Developer Mode in Discord settings).
DISCORD_GUILD_ID=

# Automatically join the voice channel with the most people, and follow it as people move.
# Never moves mid-conversation; /leave pauses this until /join.
AUTO_JOIN=true

# speech-to-speech server started with `speech-to-speech serve ...`
S2S_URL=ws://127.0.0.1:8765/v1/realtime

# Optional
# BOT_INSTRUCTIONS=You are Alex, a friendly voice assistant...
# WAKE_WORDS=hey alex,ok alex,okay alex,hi alex,hello alex,艾利同學
#   English: "<greeting> <name>" phrases. Chinese: matched by pronunciation, so 艾丽同学 / 爱丽同学 /
#   艾莉同學 all count; it must come at the start (at most two syllables before it, e.g. 嘿，艾丽同学).
# WAKE_ALIASES=alec,alix,alax   # mishearings of the name that also count
# WAKE_MODEL=mlx-community/Qwen3-ASR-1.7B-8bit   # or Qwen3-ASR-0.6B-8bit (faster, less accurate), sensevoice (CPU),
#   or server: no model in the bot, use the speech server's (needs --stt mlx-audio-qwen3-asr; saves ~2.3 GB)
# WAKE_VAD_THRESHOLD=0.5  # Silero VAD before each wake check: noise is not transcribed (higher = stricter, 0 = off)
# WAKE_TIMEOUT_SECONDS=6   # go back to sleep if nobody speaks after the wake word
# FOLLOWUP_SECONDS=8       # keep listening this long after the reply finishes playing (0 = always need the wake word)
# SERPER_API_KEY=          # enables the web_search tool
# DJ_ALEX_URL=http://192.168.1.20:3000   # DJ Alex music bot (github.com/dazchi/dj-alex): with DJ_ALEX_TOKEN,
# DJ_ALEX_TOKEN=           #   Alex can play and control music; the token is CONTROL_TOKEN in DJ Alex's .env
# DUCK_MUSIC_LEVEL=30      # DJ Alex's music plays at this % of its volume while Alex speaks (100 = never lower it)
# SEARCH_PREAMBLE=我幫你查查看啦，吼。|等我一下喔，我查一下。   # said before the first search; several
#                          # separated by "|" are picked at random per question; empty = no fixed sentence
# CATCHPHRASES=我跟你說喔|真的假的   # Alex's catchphrases, separated by "|" like SEARCH_PREAMBLE; empty = none
# CATCHPHRASE_RATE=0.3     # chance that a reply uses one (0 to 1)
# GREET_ON_JOIN=true       # greet people (not bots) who join the voice channel
# GREET_COOLDOWN_SECONDS=300   # do not greet the same person again within this time
# GREETING_PROMPT=Greet {name}, who just joined the voice channel, with one short sentence in your own style.
# MENTION_TEXT_REPLY=true  # "@AI Alex ..." in chat: also reply with the answer's text (voice answer either way)
# ALLOW_INTERRUPTIONS=true # false: the speaker cannot cut Alex off while it is thinking or speaking (web searches are never interrupted)
# MAX_TOOL_ROUNDS=2        # tool calls per question before Alex must answer with what it found
# TOOL_MODULES=discord_bot.tools.discord_channels,discord_bot.tools.web_search,my_tools
#   default: discord_channels (read channels; needs the Message Content intent), plus web_search with SERPER_API_KEY
#   and dj_alex with DJ_ALEX_URL and DJ_ALEX_TOKEN
# OPUS_LIBRARY=/opt/homebrew/lib/libopus.dylib
# AUDIO_DEBUG=1           # log per-user audio stats and record what the bot hears to discord_bot/debug_audio/
